# Localhost, loopback, and local LAN addresses use only development settings.
# Supply a separate Supabase development project/branch, or a local Supabase stack.
VITE_SUPABASE_DEV_URL=https://nlwtzggjjbacndirlggj.supabase.co
VITE_SUPABASE_DEV_PUBLISHABLE_KEY=

# Public domain names (including arcadegambit.com) use production settings.
VITE_SUPABASE_PROD_URL=https://smdwmvfkyumxuxbnzitq.supabase.co
VITE_SUPABASE_PROD_PUBLISHABLE_KEY=your-production-publishable-key

# Google Analytics 4: public Measurement ID, not an API secret. Blank disables it.
VITE_GA_MEASUREMENT_ID=
# Optional separate test property for localhost/LAN; never uses the production ID.
VITE_GA_DEV_MEASUREMENT_ID=
